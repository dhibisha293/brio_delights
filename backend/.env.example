# Supabase credentials (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend URL(s) for CORS. Can be comma-separated list of origins.
# For local development: http://localhost:5173
# For production: https://your-brio-frontend.vercel.app
# Note: Any *.vercel.app domain is also automatically allowed via regex.
FRONTEND_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# SSL certificate verification for Supabase connection (true by default)
SUPABASE_SSL_VERIFY=true

# AI Assistant credentials (OpenAI or Groq)
# Set AI_API_KEY with your OpenAI key or Groq key (starts with gsk_)
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
